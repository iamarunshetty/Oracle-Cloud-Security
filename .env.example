# ─────────────────────────────────────────────────────────────────────────────
# Oracle Fusion Security Administration Workbench — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Oracle Fusion Security Administration Workbench"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=change-me-use-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (SQL Server) ─────────────────────────────────────────────────────
# For SQL Server (production):
DATABASE_URL=******db:1433/oracle_security?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# For local SQLite development (no SQL Server required):
# DATABASE_URL=sqlite:///./dev.db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Oracle Fusion Cloud ───────────────────────────────────────────────────────
ORACLE_FUSION_BASE_URL=https://your-instance.oraclecloud.com
ORACLE_FUSION_CLIENT_ID=your-client-id
ORACLE_FUSION_CLIENT_SECRET=your-client-secret
ORACLE_FUSION_TOKEN_URL=https://your-instance.oraclecloud.com/oauth/token

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text
